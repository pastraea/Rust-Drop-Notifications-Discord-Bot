{
    "name": "rust-drops-reminder-bot",
    "version": "0.1.4",
    "private": true,
    "description": "Discord reminder bot for Twitch and Kick Rust drops",
    "author": "Thomas Benton",
    "license": "MIT",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test src/**/*.test.ts",
        "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html tsx --test src/**/*.test.ts",
        "start": "node dist/index.js",
        "deploy-commands": "tsx src/commands/registerCommands.ts"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.26.4",
        "dotenv": "^18.0.7",
        "ffmpeg-static": "^5.3.0",
        "gifwrap": "^0.10.1",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.6.5",
        "c8": "^12.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
