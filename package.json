{
    "name": "rust-drops-reminder-bot",
    "version": "0.4.1",
    "private": true,
    "description": "Discord reminder bot for Twitch and Kick Rust drops",
    "author": "Thomas Benton",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "dist/index.js",
    "scripts": {
        "build:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src\\installer\\Build-Executable.ps1",
        "installer": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File src\\installer\\Start-Installer.ps1",
        "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src\\installer\\Test-WindowsUninstall.ps1",
        "test:updater": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src\\installer\\Test-WindowsUpdate.ps1",
        "dev": "tsx src/index.ts",
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test src/**/*.test.ts",
        "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html tsx --test src/**/*.test.ts",
        "lint": "biome lint --error-on-warnings src",
        "start": "node dist/index.js",
        "deploy-commands": "tsx src/commands/registerCommands.ts"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.26.4",
        "dotenv": "^18.0.9",
        "ffmpeg-static": "^5.3.0",
        "gifwrap": "^0.10.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.5",
        "c8": "^12.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
